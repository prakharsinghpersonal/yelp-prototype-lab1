# ─── Database ────────────────────────────────────────────────────────────────
# MySQL (required for production / Prakhar's setup)
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/yelp_db

# SQLite alternative (local dev only — DO NOT use for grading)
# DATABASE_URL=sqlite:///./yelp.db

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars

# ─── AI Features ─────────────────────────────────────────────────────────────
# Groq (LLM for AI chat + autofill extraction)
GROQ_API_KEY=your_groq_api_key_here

# Tavily (web search for autofill)
TAVILY_API_KEY=your_tavily_api_key_here

# Google Maps (optional — for map display)
GOOGLE_API_KEY=your_google_maps_api_key_here
